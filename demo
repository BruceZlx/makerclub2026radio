#include <WiFi.h>
#include <HTTPClient.h>

const char* URL = "http://wfuv-onair.streamguys.org/onair-hi";

void setup() {
  Serial.begin(115200);
  WiFi.begin("wifi名称", "密码");
  while (WiFi.status() != WL_CONNECTED) delay(500);
  Serial.println("WiFi OK");

  HTTPClient http;
  http.begin(URL);
  int code = http.GET();
  Serial.printf("HTTP 状态: %d\n", code);
  Serial.printf("Content-Type: %s\n",
                http.header("Content-Type").c_str());

  WiFiClient* s = http.getStreamPtr();
  uint8_t buf[256];
  unsigned long t0 = millis();
  int n = s->readBytes(buf, sizeof(buf));
  Serial.print("前16字节: ");
  for (int i = 0; i < 16; i++) {
    Serial.printf("%02X ", buf[i]);
  }
  Serial.println();

  Serial.printf("收到 %d 字节, 用时 %lu ms\n", n, millis() - t0);

  http.end();
}

void loop() {}